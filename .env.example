# ElevenLabs (speech to text and text to speech)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
STT_MODEL=scribe_v2
# Empty = auto-detect. "fas" forces Persian.
STT_LANGUAGE=
TTS_MODEL=eleven_v3
# Optional: any ElevenLabs voice id (a default voice is built in)
# TTS_VOICE=your-elevenlabs-voice-id

# WhatsApp Cloud API (Meta)
WA_TOKEN=your-whatsapp-access-token
WA_PHONE_ID=your-whatsapp-phone-number-id
# Meta app > App settings > Basic > App secret. Checks every webhook is really from Meta.
WA_APP_SECRET=your-meta-app-secret
# Any random string, also pasted into Meta's webhook settings.
VERIFY_TOKEN=your-random-verify-string
# Comma separated, international format without "+". Empty = nobody gets an answer.
ALLOWED_WA_NUMBERS=

# Telegram
TG_TOKEN=your-telegram-bot-token
# Comma separated numeric Telegram user ids. Empty = nobody gets an answer.
ALLOWED_USER_IDS=

# Optional translation. Leave either one empty to turn translation off.
ANTHROPIC_API_KEY=
TRANSLATE_MODEL=

# Optional: hours from UTC for transcript file names (default 0).
TZ_OFFSET_HOURS=0
# Optional: host port for the WhatsApp webhook (default 8000).
HOST_PORT=8000
